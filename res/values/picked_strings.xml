    <!-- Thanks to -->
    <string name="picked_thanks_header">Miku-Picked UI is Miku UI plus features cherry-picked from other projects. Thank you!</string>
    <string name="picked_thanks_base_category">Base</string>
    <string name="picked_thanks_picked_category">Picked from</string>
    <string name="picked_thanks_others_category">Also thanks to</string>
    <string name="picked_thanks_miku_title">Miku UI</string>
    <string name="picked_thanks_miku_summary">The base of everything: Miku UI Android 16 (Blooming V2) and all of its features</string>
    <string name="picked_thanks_aosp_title">Android Open Source Project</string>
    <string name="picked_thanks_aosp_summary">Android 16 (android-16.0.0_r4)</string>
    <string name="picked_thanks_lineage_title">LineageOS</string>
    <string name="picked_thanks_lineage_summary">HALs, LineageOS 23.2 device tree compatibility, advanced restart menu, power menu helpers</string>
    <string name="picked_thanks_infinity_title">Infinity X</string>
    <string name="picked_thanks_infinity_summary">Status bar logo, battery bar</string>
    <string name="picked_thanks_axion_title">AxionOS</string>
    <string name="picked_thanks_axion_summary">AxionFx audio effects, status/nav bar burn-in protection, advanced restart with Restart SystemUI, flashlight fade, 5G tile, the emoji style switch</string>
    <string name="picked_thanks_uwu_title">uwuAOSP</string>
    <string name="picked_thanks_uwu_summary">Deep sleep time in uptime, auto brightness tile, full screen apps for display cutouts</string>
    <string name="picked_thanks_evolution_title">Evolution X</string>
    <string name="picked_thanks_evolution_summary">Custom lockscreen clocks (with crDroid and risingOS), fingerprint icons, selectable emoji, sleep mode, QS tile toggle animations, custom carrier label, volume slider haptics switch</string>
    <string name="picked_thanks_lunaris_title">Lunaris AOSP</string>
    <string name="picked_thanks_lunaris_summary">Separate notifications and quick settings shade, landscape split shade switch, screenshot flash and status bar options</string>
    <string name="picked_thanks_oneuisland_title">OneUisland</string>
    <string name="picked_thanks_oneuisland_summary">The dynamic island, by Spottq, with additions by csabaikende-ctrl</string>
    <string name="picked_thanks_devices_category">Device trees</string>
    <string name="picked_thanks_exy2100_title">exy2100</string>
    <string name="picked_thanks_exy2100_summary">Samsung Galaxy S21 Exynos (o1s) device trees, kernel and vendor, Samsung and SLSI hardware (ata-kaner, mst8981, Flopster101)</string>
    <string name="picked_thanks_mack_title">Macktherealonereally</string>
    <string name="picked_thanks_mack_summary">Galaxy S21 Exynos trees and kernel used here, with fixes for VoLTE, eSIM, NFC, WPA3 hotspot, 60 fps video and charge limit</string>
    <string name="picked_thanks_crdroid_title">crDroid, AICP, OmniROM, PixelExperience and more</string>
    <string name="picked_thanks_crdroid_summary">Where many of the picked features were first written</string>
    <string name="picked_thanks_authors_title">Every original author</string>
    <string name="picked_thanks_authors_summary">Each picked commit keeps its original author in the git history</string>
    <string name="picked_thanks_claude_title">Claude (Anthropic)</string>
    <string name="picked_thanks_claude_summary">Claude Opus 5.5 ported and integrated the picked features, and wrote the LineageOS device tree compatibility</string>
    <string name="picked_thanks_you_title">You</string>
    <string name="picked_thanks_you_summary">For using Miku-Picked UI</string>

