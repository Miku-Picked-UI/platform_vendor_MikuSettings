<!-- [Lunaris AOSP] Lunaris Bar. Keys and defaults match
     com.android.systemui.statusbar.featurepods.popups.shared.DynamicIslandFeatureSettings. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="picked_lunaris_bar"
    android:title="@string/picked_lunaris_bar_title">

    <com.miku.settings.preferences.SystemSettingSwitchPreference
        android:key="status_bar_show_dynamic_island"
        android:title="@string/picked_lunaris_bar_enable_title"
        android:summary="@string/picked_lunaris_bar_enable_summary"
        android:defaultValue="false" />

    <com.miku.settings.preferences.SystemSettingSwitchPreference
        android:key="status_bar_dynamic_island_lockscreen"
        android:title="@string/picked_lunaris_bar_lockscreen_title"
        android:summary="@string/picked_lunaris_bar_lockscreen_summary"
        android:defaultValue="false"
        android:dependency="status_bar_show_dynamic_island" />

    <com.miku.settings.preferences.SystemSettingSwitchPreference
        android:key="status_bar_dynamic_island_disable_in_landscape"
        android:title="@string/picked_lunaris_bar_landscape_title"
        android:summary="@string/picked_lunaris_bar_landscape_summary"
        android:defaultValue="false"
        android:dependency="status_bar_show_dynamic_island" />

    <!-- Popups -->
    <PreferenceCategory
        android:key="picked_lunaris_bar_popups"
        android:title="@string/picked_lunaris_bar_popups_category"
        android:dependency="status_bar_show_dynamic_island">

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_media_controls"
            android:title="@string/picked_lunaris_bar_media_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_redesigned_media"
            android:title="@string/picked_lunaris_bar_redesigned_media_title"
            android:defaultValue="true"
            android:dependency="status_bar_dynamic_island_media_controls" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_lyrics"
            android:title="@string/picked_lunaris_bar_lyrics_title"
            android:defaultValue="false"
            android:dependency="status_bar_dynamic_island_media_controls" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_screen_recording"
            android:title="@string/picked_lunaris_bar_screen_recording_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_alarms"
            android:title="@string/picked_lunaris_bar_alarms_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_stopwatch"
            android:title="@string/picked_lunaris_bar_stopwatch_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_flashlight"
            android:title="@string/picked_lunaris_bar_flashlight_title"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- Events -->
    <PreferenceCategory
        android:key="picked_lunaris_bar_events"
        android:title="@string/picked_lunaris_bar_events_category"
        android:dependency="status_bar_show_dynamic_island">

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_calls"
            android:title="@string/picked_lunaris_bar_calls_title"
            android:summary="@string/picked_lunaris_bar_calls_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_notifications"
            android:title="@string/picked_lunaris_bar_notifications_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_ongoing_activities"
            android:title="@string/picked_lunaris_bar_ongoing_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_timer"
            android:title="@string/picked_lunaris_bar_timer_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_audio_recording"
            android:title="@string/picked_lunaris_bar_audio_recording_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_battery"
            android:title="@string/picked_lunaris_bar_battery_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_unlock"
            android:title="@string/picked_lunaris_bar_unlock_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_bluetooth"
            android:title="@string/picked_lunaris_bar_bluetooth_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_hotspot"
            android:title="@string/picked_lunaris_bar_hotspot_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_vpn"
            android:title="@string/picked_lunaris_bar_vpn_title"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_ringer"
            android:title="@string/picked_lunaris_bar_ringer_title"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- Appearance -->
    <PreferenceCategory
        android:key="picked_lunaris_bar_appearance"
        android:title="@string/picked_lunaris_bar_appearance_category"
        android:dependency="status_bar_show_dynamic_island">

        <com.miku.settings.preferences.CustomSystemSeekBarPreference
            android:key="status_bar_dynamic_island_width_scale"
            android:title="@string/picked_lunaris_bar_width_title"
            android:min="70"
            android:max="140"
            android:defaultValue="100"
            settings:units="%" />

        <com.miku.settings.preferences.CustomSystemSeekBarPreference
            android:key="status_bar_dynamic_island_height_scale"
            android:title="@string/picked_lunaris_bar_height_title"
            android:min="70"
            android:max="140"
            android:defaultValue="100"
            settings:units="%" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_dynamic_island_popup_color_mode"
            android:title="@string/picked_lunaris_bar_popup_color_title"
            android:entries="@array/picked_lunaris_bar_popup_color_entries"
            android:entryValues="@array/picked_lunaris_bar_popup_color_values"
            android:defaultValue="0" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="media_waveform_seekbar"
            android:title="@string/picked_lunaris_bar_seekbar_title"
            android:entries="@array/picked_lunaris_bar_seekbar_entries"
            android:entryValues="@array/picked_lunaris_bar_seekbar_values"
            android:defaultValue="0" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_alternative_animation"
            android:title="@string/picked_lunaris_bar_alt_animation_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_alternative_media"
            android:title="@string/picked_lunaris_bar_alt_media_title"
            android:defaultValue="true" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_dynamic_island_alternative_flashlight"
            android:title="@string/picked_lunaris_bar_alt_flashlight_title"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
