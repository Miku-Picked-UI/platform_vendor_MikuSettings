<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="picked_features"
    android:title="@string/picked_features_title">

    <!-- ===== Style ===== -->
    <PreferenceCategory
        android:key="picked_category_style"
        android:title="@string/picked_category_style">

        <!-- [Evolution X] Custom lockscreen clocks -->
        <Preference
            android:key="picked_clock_styles"
            android:title="@string/picked_clock_styles_title"
            android:summary="@string/picked_clock_styles_summary"
            android:fragment="com.miku.exsettings.fragments.PickedClockStyles" />

        <!-- [Miku-Picked UI] Now Bar: lockscreen media pill (Settings.System.NOW_BAR_ENABLED) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="now_bar_enabled"
            android:title="@string/picked_now_bar_title"
            android:summary="@string/picked_now_bar_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Now Bar background (Settings.System.NOW_BAR_STYLE) -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="now_bar_style"
            android:title="@string/picked_now_bar_style_title"
            android:summary="%s"
            android:entries="@array/picked_now_bar_style_entries"
            android:entryValues="@array/picked_now_bar_style_values"
            android:defaultValue="0"
            android:dependency="now_bar_enabled" />

        <!-- [PenguinOS] System-wide Liquid Glass: SurfaceFlinger draws every blur as glass
             (persist.sys.penguin.liquid_glass / _refraction, read live by renderengine) -->
        <SwitchPreferenceCompat
            android:key="picked_liquid_glass"
            android:title="@string/picked_liquid_glass_title"
            android:summary="@string/picked_liquid_glass_summary"
            android:persistent="false" />

        <com.miku.exsettings.preferences.CustomSeekBarPreference
            android:key="picked_liquid_glass_refraction"
            android:title="@string/picked_liquid_glass_refraction_title"
            android:summary="@string/picked_liquid_glass_refraction_summary"
            settings:min="0"
            android:max="100"
            android:defaultValue="60"
            settings:units="%"
            android:persistent="false"
            android:dependency="picked_liquid_glass" />

        <!-- [Miku UI] System font (Miku's font picker) -->
        <Preference
            android:key="picked_fonts"
            android:title="@string/theme_customization_font_title"
            android:summary="@string/picked_fonts_summary"
            android:fragment="com.miku.exsettings.fragments.FontsPicker" />

        <!-- [Evolution X / AxionOS] Emoji style (persist.sys.ax_emoji_style) -->
        <ListPreference
            android:key="picked_emoji_style"
            android:title="@string/picked_emoji_style_title"
            android:summary="%s"
            android:entries="@array/picked_emoji_style_entries"
            android:entryValues="@array/picked_emoji_style_values"
            android:persistent="false" />
        <!-- The entries above are replaced in PickedFeatures by the installed styles. -->

        <!-- [Evolution X] Fingerprint icon (under-display sensors) -->
        <Preference
            android:key="picked_udfps_icon"
            android:title="@string/picked_udfps_icon_title"
            android:summary="@string/picked_udfps_icon_summary"
            android:fragment="com.miku.exsettings.fragments.PickedUdfpsIcons" />
    </PreferenceCategory>

    <!-- ===== Status bar ===== -->
    <PreferenceCategory
        android:key="picked_category_statusbar"
        android:title="@string/picked_category_statusbar">

        <!-- [OneUisland] Dynamic island -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="oneuisland_enabled"
            android:title="@string/picked_oneuisland_enable_title"
            android:summary="@string/picked_oneuisland_enable_summary"
            android:defaultValue="true" />

        <Preference
            android:key="picked_oneuisland_settings"
            android:title="@string/picked_oneuisland_settings_title"
            android:summary="@string/picked_oneuisland_settings_summary"
            android:dependency="oneuisland_enabled">
            <intent
                android:targetPackage="dev.flexy.dynamicisland"
                android:targetClass="dev.flexy.dynamicisland.SettingsActivity" />
        </Preference>

        <!-- [Infinity X] Status bar logo -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_logo"
            android:title="@string/picked_logo_title"
            android:summary="@string/picked_logo_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_position"
            android:title="@string/picked_logo_position_title"
            android:entries="@array/picked_logo_position_entries"
            android:entryValues="@array/picked_logo_position_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_style"
            android:title="@string/picked_logo_style_title"
            android:entries="@array/picked_logo_style_entries"
            android:entryValues="@array/picked_logo_style_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_color"
            android:title="@string/picked_logo_color_title"
            android:entries="@array/picked_logo_color_entries"
            android:entryValues="@array/picked_logo_color_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="status_bar_logo_color_picker"
            android:title="@string/picked_logo_color_picker_title"
            settings:defaultColorValue="0xff1a73e8"
            android:dependency="status_bar_logo" />

        <!-- [Infinity X] Battery bar -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar"
            android:title="@string/picked_battery_bar_title"
            android:summary="@string/picked_battery_bar_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="statusbar_battery_bar_style"
            android:title="@string/picked_battery_bar_style_title"
            android:entries="@array/picked_battery_bar_style_entries"
            android:entryValues="@array/picked_battery_bar_style_values"
            android:defaultValue="0"
            android:dependency="statusbar_battery_bar" />

        <com.miku.exsettings.preferences.CustomSystemSeekBarPreference
            android:key="statusbar_battery_bar_thickness"
            android:title="@string/picked_battery_bar_thickness_title"
            settings:min="1"
            android:max="4"
            android:defaultValue="2"
            settings:units="dp"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_animate"
            android:title="@string/picked_battery_bar_animate_title"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_color"
            android:title="@string/picked_battery_bar_color_title"
            settings:defaultColorValue="0xff76c124"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_enable_charging_color"
            android:title="@string/picked_battery_bar_charging_color_enable_title"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_charging_color"
            android:title="@string/picked_battery_bar_charging_color_title"
            settings:defaultColorValue="0xffffc90f"
            android:dependency="statusbar_battery_bar_enable_charging_color" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_battery_low_color"
            android:title="@string/picked_battery_bar_low_color_title"
            settings:defaultColorValue="0xfff90028"
            android:dependency="statusbar_battery_bar" />

        <!-- [Evolution X] Custom carrier label -->
        <com.miku.settings.preferences.SystemSettingEditTextPreference
            android:key="lockscreen_show_custom_carrier_text"
            android:title="@string/picked_carrier_label_title"
            android:summary="@string/picked_carrier_label_summary"
            android:dialogTitle="@string/picked_carrier_label_title"
            android:singleLine="true" />
    </PreferenceCategory>

    <!-- ===== Quick settings ===== -->
    <PreferenceCategory
        android:key="picked_category_qs"
        android:title="@string/picked_category_qs">

        <!-- [Evolution X] Tile toggle animation -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="qs_tile_animation_style"
            android:title="@string/picked_qs_tile_anim_title"
            android:entries="@array/picked_qs_tile_anim_entries"
            android:entryValues="@array/picked_qs_tile_anim_values"
            android:defaultValue="0" />

        <!-- [Lunaris AOSP] Split notification shade -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_split_shade"
            android:title="@string/picked_qs_split_shade_title"
            android:summary="@string/picked_qs_split_shade_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_split_notification"
            android:title="@string/picked_qs_split_notification_title"
            android:summary="@string/picked_qs_split_notification_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- ===== Power and sleep ===== -->
    <PreferenceCategory
        android:key="picked_category_power"
        android:title="@string/picked_category_power">

        <!-- [LineageOS / AxionOS] Advanced restart -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="advanced_reboot"
            android:title="@string/picked_advanced_reboot_title"
            android:summary="@string/picked_advanced_reboot_summary"
            android:defaultValue="false" />

        <!-- [Evolution X] Sleep mode -->
        <Preference
            android:key="picked_sleep_mode"
            android:title="@string/picked_sleep_mode_title"
            android:summary="@string/picked_sleep_mode_summary"
            android:fragment="com.miku.exsettings.fragments.PickedSleepMode" />
    </PreferenceCategory>

    <!-- ===== Display ===== -->
    <PreferenceCategory
        android:key="picked_category_display"
        android:title="@string/picked_category_display">

        <!-- [uwuAOSP] Cutout force full screen -->
        <Preference
            android:key="picked_cutout_apps"
            android:title="@string/picked_cutout_apps_title"
            android:summary="@string/picked_cutout_apps_summary"
            android:fragment="com.miku.exsettings.fragments.PickedCutoutApps" />
    </PreferenceCategory>

    <!-- ===== Sound ===== -->
    <PreferenceCategory
        android:key="picked_category_sound"
        android:title="@string/picked_category_sound">

        <!-- [Evolution X] Volume dialog haptics -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="volume_dialog_haptic_feedback"
            android:title="@string/picked_volume_haptics_title"
            android:summary="@string/picked_volume_haptics_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Skip tracks with the volume keys (Settings.System.VOLUME_BUTTON_MUSIC_CONTROL) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_button_music_control"
            android:title="@string/picked_volume_music_control_title"
            android:summary="@string/picked_volume_music_control_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- ===== Screenshots ===== -->
    <PreferenceCategory
        android:key="picked_category_screenshot"
        android:title="@string/picked_category_screenshot">

        <!-- [Lunaris AOSP] Screenshot flash -->
        <com.miku.settings.preferences.GlobalSettingSwitchPreference
            android:key="screenshot_flash_enabled"
            android:title="@string/picked_screenshot_flash_title"
            android:summary="@string/picked_screenshot_flash_summary"
            android:defaultValue="true" />

        <!-- [Lunaris AOSP] Hide status bar in screenshots -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="hide_status_bar_in_screenshot"
            android:title="@string/picked_screenshot_hide_statusbar_title"
            android:summary="@string/picked_screenshot_hide_statusbar_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- ===== Connected devices ===== -->
    <PreferenceCategory
        android:key="picked_category_devices"
        android:title="@string/picked_category_devices">

        <!-- [GoogleSpoofForWear by 73sydney] Google as brand/manufacturer for watch apps
             (persist.sys.picked.google_spoof_wear, read by android.os.Build at boot) -->
        <SwitchPreferenceCompat
            android:key="picked_google_spoof_wear"
            android:title="@string/picked_google_spoof_wear_title"
            android:summary="@string/picked_google_spoof_wear_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
