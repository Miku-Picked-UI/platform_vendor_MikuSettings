<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="picked_features"
    android:title="@string/picked_features_title">

    <!-- ===== Style ===== -->
    <PreferenceCategory
        android:key="picked_category_style"
        android:title="@string/picked_category_style">

        <!-- [Miku-Picked UI] Boot animation picker (persist.sys.picked.bootanim) -->
        <Preference
            android:key="picked_bootanim"
            android:title="@string/picked_bootanim_title"
            android:summary="@string/picked_bootanim_summary"
            android:fragment="com.miku.exsettings.fragments.PickedBootAnimation" />

        <!-- [Miku-Picked UI] Depth wallpaper (SystemUI DepthWallpaperSection) -->
        <Preference
            android:key="picked_depth_wallpaper"
            android:title="@string/picked_depth_title"
            android:summary="@string/picked_depth_summary"
            android:fragment="com.miku.exsettings.fragments.PickedDepthWallpaper" />

        <!-- [Miku-Picked UI] Reactive live wallpaper (vendor/miku/picked/reactive_wallpaper) -->
        <Preference
            android:key="picked_reactive_wallpaper"
            android:title="@string/picked_reactive_wallpaper_title"
            android:summary="@string/picked_reactive_wallpaper_summary">
            <intent
                android:action="android.service.wallpaper.CHANGE_LIVE_WALLPAPER">
                <extra
                    android:name="android.service.wallpaper.extra.LIVE_WALLPAPER_COMPONENT"
                    android:value="com.mikupicked.reactivewallpaper/.ReactiveWallpaperService" />
            </intent>
        </Preference>

        <!-- [Miku-Picked UI] Weather for the custom clocks (SystemUI WeatherRepository, Open-Meteo) -->
        <Preference
            android:key="picked_weather"
            android:title="@string/picked_weather_title"
            android:summary="@string/picked_weather_summary"
            android:fragment="com.miku.exsettings.fragments.PickedWeather" />

        <!-- [Evolution X] Custom lockscreen clocks -->
        <Preference
            android:key="picked_clock_styles"
            android:title="@string/picked_clock_styles_title"
            android:summary="@string/picked_clock_styles_summary"
            android:fragment="com.miku.exsettings.fragments.PickedClockStyles" />

        <!-- [Miku-Picked UI] Now Bar: lockscreen media pill (Settings.System.NOW_BAR_ENABLED) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="now_bar_enabled"
            android:title="@string/picked_now_bar_title"
            android:summary="@string/picked_now_bar_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Now Bar background (Settings.System.NOW_BAR_STYLE) -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="now_bar_style"
            android:title="@string/picked_now_bar_style_title"
            android:summary="%s"
            android:entries="@array/picked_now_bar_style_entries"
            android:entryValues="@array/picked_now_bar_style_values"
            android:defaultValue="0"
            android:dependency="now_bar_enabled" />

        <!-- [PenguinOS] System-wide Liquid Glass: SurfaceFlinger draws every blur as glass
             (persist.sys.penguin.liquid_glass / _refraction, read live by renderengine) -->
        <SwitchPreferenceCompat
            android:key="picked_liquid_glass"
            android:title="@string/picked_liquid_glass_title"
            android:summary="@string/picked_liquid_glass_summary"
            android:persistent="false" />

        <ListPreference
            android:key="picked_liquid_glass_style"
            android:title="@string/picked_liquid_glass_style_title"
            android:summary="%s"
            android:entries="@array/picked_liquid_glass_style_entries"
            android:entryValues="@array/picked_liquid_glass_style_values"
            android:persistent="false"
            android:dependency="picked_liquid_glass" />

        <com.miku.exsettings.preferences.CustomSeekBarPreference
            android:key="picked_liquid_glass_refraction"
            android:title="@string/picked_liquid_glass_refraction_title"
            android:summary="@string/picked_liquid_glass_refraction_summary"
            settings:min="0"
            android:max="100"
            android:defaultValue="60"
            settings:units="%"
            android:persistent="false"
            android:dependency="picked_liquid_glass" />

        <!-- [PenguinOS] ColorOS app open / close motion (Settings.Secure penguin_cos_app_motion,
             read by Launcher3) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="penguin_cos_app_motion"
            android:title="@string/picked_cos_app_motion_title"
            android:summary="@string/picked_cos_app_motion_summary"
            android:defaultValue="true" />

        <!-- [PenguinOS] Quick Settings panel style (Settings.Secure qs_panel_style) -->
        <com.miku.settings.preferences.SecureSettingListPreference
            android:key="qs_panel_style"
            android:title="@string/picked_qs_panel_style_title"
            android:summary="%s"
            android:entries="@array/picked_qs_panel_style_entries"
            android:entryValues="@array/picked_qs_panel_style_values"
            android:defaultValue="6" />

        <!-- [PenguinOS] Lockscreen clock flies onto the home screen on unlock
             (Settings.Secure picked_clock_fly, read by SystemUI and Launcher3) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_clock_fly"
            android:title="@string/picked_clock_fly_title"
            android:summary="@string/picked_clock_fly_summary"
            android:defaultValue="false" />

        <!-- [Miku-Picked UI] Shade blur strength (Settings.System picked_shade_blur, %) -->
        <com.miku.exsettings.preferences.CustomSystemSeekBarPreference
            android:key="picked_shade_blur"
            android:title="@string/picked_shade_blur_title"
            android:summary="@string/picked_shade_blur_summary"
            settings:min="0"
            android:max="100"
            android:defaultValue="100"
            settings:units="%" />

        <!-- [PenguinOS] Media volume slider in Quick Settings (Settings.System picked_qs_volume_slider) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="picked_qs_volume_slider"
            android:title="@string/picked_qs_volume_slider_title"
            android:summary="@string/picked_qs_volume_slider_summary"
            android:defaultValue="true" />

        <!-- [PenguinOS] Volume panel style (Settings.Secure volume_panel_style) -->
        <com.miku.settings.preferences.SecureSettingListPreference
            android:key="volume_panel_style"
            android:title="@string/picked_volume_panel_style_title"
            android:summary="%s"
            android:entries="@array/picked_volume_panel_style_entries"
            android:entryValues="@array/picked_volume_panel_style_values"
            android:defaultValue="0" />

        <!-- [PenguinOS] Liquid Glass tab bars in apps (Settings.Secure penguin_glass_tab_bars) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="penguin_glass_tab_bars"
            android:title="@string/picked_glass_tab_bars_title"
            android:summary="@string/picked_glass_tab_bars_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="penguin_glass_tab_bars_float"
            android:title="@string/picked_glass_tab_bars_float_title"
            android:summary="@string/picked_glass_tab_bars_float_summary"
            android:defaultValue="false"
            android:dependency="penguin_glass_tab_bars" />

        <!-- [Miku-Picked UI] iOS 26 style glass buttons in apps (Settings.Secure picked_glass_buttons) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_glass_buttons"
            android:title="@string/picked_glass_buttons_title"
            android:summary="@string/picked_glass_buttons_summary"
            android:defaultValue="false" />

        <!-- [Miku UI] System font (Miku's font picker) -->
        <Preference
            android:key="picked_fonts"
            android:title="@string/theme_customization_font_title"
            android:summary="@string/picked_fonts_summary"
            android:fragment="com.miku.exsettings.fragments.FontsPicker" />

        <!-- [Evolution X / AxionOS] Emoji style (persist.sys.ax_emoji_style) -->
        <ListPreference
            android:key="picked_emoji_style"
            android:title="@string/picked_emoji_style_title"
            android:summary="%s"
            android:entries="@array/picked_emoji_style_entries"
            android:entryValues="@array/picked_emoji_style_values"
            android:persistent="false" />
        <!-- The entries above are replaced in PickedFeatures by the installed styles. -->

        <!-- [Evolution X] Fingerprint icon (under-display sensors) -->
        <Preference
            android:key="picked_udfps_icon"
            android:title="@string/picked_udfps_icon_title"
            android:summary="@string/picked_udfps_icon_summary"
            android:fragment="com.miku.exsettings.fragments.PickedUdfpsIcons" />

        <!-- [Miku-Picked UI] Unlock animation (Settings.System picked_unlock_animation,
             SystemUI picked/unlock/PickedUnlockEffect drawn by AuthRippleView) -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="picked_unlock_animation"
            android:title="@string/picked_unlock_animation_title"
            android:summary="%s"
            android:entries="@array/picked_unlock_animation_entries"
            android:entryValues="@array/picked_unlock_animation_values"
            android:defaultValue="0" />
    </PreferenceCategory>

    <!-- ===== Status bar ===== -->
    <PreferenceCategory
        android:key="picked_category_statusbar"
        android:title="@string/picked_category_statusbar">

        <!-- [OneUisland] Dynamic island -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="oneuisland_enabled"
            android:title="@string/picked_oneuisland_enable_title"
            android:summary="@string/picked_oneuisland_enable_summary"
            android:defaultValue="true" />

        <Preference
            android:key="picked_oneuisland_settings"
            android:title="@string/picked_oneuisland_settings_title"
            android:summary="@string/picked_oneuisland_settings_summary"
            android:dependency="oneuisland_enabled">
            <intent
                android:targetPackage="dev.flexy.dynamicisland"
                android:targetClass="dev.flexy.dynamicisland.SettingsActivity" />
        </Preference>

        <!-- [Infinity X] Status bar logo -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="status_bar_logo"
            android:title="@string/picked_logo_title"
            android:summary="@string/picked_logo_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_position"
            android:title="@string/picked_logo_position_title"
            android:entries="@array/picked_logo_position_entries"
            android:entryValues="@array/picked_logo_position_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_style"
            android:title="@string/picked_logo_style_title"
            android:entries="@array/picked_logo_style_entries"
            android:entryValues="@array/picked_logo_style_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="status_bar_logo_color"
            android:title="@string/picked_logo_color_title"
            android:entries="@array/picked_logo_color_entries"
            android:entryValues="@array/picked_logo_color_values"
            android:defaultValue="0"
            android:dependency="status_bar_logo" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="status_bar_logo_color_picker"
            android:title="@string/picked_logo_color_picker_title"
            settings:defaultColorValue="0xff1a73e8"
            android:dependency="status_bar_logo" />

        <!-- [Infinity X] Battery bar -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar"
            android:title="@string/picked_battery_bar_title"
            android:summary="@string/picked_battery_bar_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="statusbar_battery_bar_style"
            android:title="@string/picked_battery_bar_style_title"
            android:entries="@array/picked_battery_bar_style_entries"
            android:entryValues="@array/picked_battery_bar_style_values"
            android:defaultValue="0"
            android:dependency="statusbar_battery_bar" />

        <com.miku.exsettings.preferences.CustomSystemSeekBarPreference
            android:key="statusbar_battery_bar_thickness"
            android:title="@string/picked_battery_bar_thickness_title"
            settings:min="1"
            android:max="4"
            android:defaultValue="2"
            settings:units="dp"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_animate"
            android:title="@string/picked_battery_bar_animate_title"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_color"
            android:title="@string/picked_battery_bar_color_title"
            settings:defaultColorValue="0xff76c124"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="statusbar_battery_bar_enable_charging_color"
            android:title="@string/picked_battery_bar_charging_color_enable_title"
            android:defaultValue="true"
            android:dependency="statusbar_battery_bar" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_charging_color"
            android:title="@string/picked_battery_bar_charging_color_title"
            settings:defaultColorValue="0xffffc90f"
            android:dependency="statusbar_battery_bar_enable_charging_color" />

        <com.miku.settings.colorpicker.SystemSettingColorPickerPreference
            android:key="statusbar_battery_bar_battery_low_color"
            android:title="@string/picked_battery_bar_low_color_title"
            settings:defaultColorValue="0xfff90028"
            android:dependency="statusbar_battery_bar" />

        <!-- [Evolution X] Custom carrier label -->
        <com.miku.settings.preferences.SystemSettingEditTextPreference
            android:key="lockscreen_show_custom_carrier_text"
            android:title="@string/picked_carrier_label_title"
            android:summary="@string/picked_carrier_label_summary"
            android:dialogTitle="@string/picked_carrier_label_title"
            android:singleLine="true" />
    </PreferenceCategory>

    <!-- ===== Quick settings ===== -->
    <PreferenceCategory
        android:key="picked_category_qs"
        android:title="@string/picked_category_qs">

        <!-- [Evolution X] Tile toggle animation -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="qs_tile_animation_style"
            android:title="@string/picked_qs_tile_anim_title"
            android:entries="@array/picked_qs_tile_anim_entries"
            android:entryValues="@array/picked_qs_tile_anim_values"
            android:defaultValue="0" />

        <!-- [Lunaris AOSP] Split notification shade -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_split_shade"
            android:title="@string/picked_qs_split_shade_title"
            android:summary="@string/picked_qs_split_shade_summary"
            android:defaultValue="false" />

        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_split_notification"
            android:title="@string/picked_qs_split_notification_title"
            android:summary="@string/picked_qs_split_notification_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- ===== Power and sleep ===== -->
    <!-- ===== Charging ===== -->
    <PreferenceCategory
        android:key="picked_category_charging"
        android:title="@string/picked_category_charging">

        <!-- [Miku-Picked UI] Battery health page -->
        <Preference
            android:key="picked_battery_health"
            android:title="@string/picked_bh_title"
            android:summary="@string/picked_bh_summary"
            android:fragment="com.miku.exsettings.fragments.PickedBatteryHealth" />

        <!-- [Evolution X / AxionOS] Lockscreen charging info (Settings.System picked_lockscreen_charging_info) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="picked_lockscreen_charging_info"
            android:title="@string/picked_lockscreen_charging_info_title"
            android:summary="@string/picked_lockscreen_charging_info_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Lockscreen charging animation (Settings.System picked_charging_animation,
             SystemUI picked/charging/ChargingAnimationController) -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="picked_charging_animation"
            android:title="@string/picked_charging_animation_title"
            android:summary="%s"
            android:entries="@array/picked_charging_animation_entries"
            android:entryValues="@array/picked_charging_animation_values"
            android:defaultValue="1" />

        <!-- [Miku-Picked UI] LineageOS IWirelessFastCharge HAL -->
        <SwitchPreferenceCompat
            android:key="picked_wireless_fast_charge"
            android:title="@string/picked_wireless_fast_charge_title"
            android:summary="@string/picked_wireless_fast_charge_summary"
            android:persistent="false" />

        <!-- [Miku-Picked UI] LineageOS IPowerShare HAL -->
        <SwitchPreferenceCompat
            android:key="picked_powershare"
            android:title="@string/picked_powershare_title"
            android:summary="@string/picked_powershare_summary"
            android:persistent="false" />

        <com.miku.exsettings.preferences.CustomSeekBarPreference
            android:key="picked_powershare_min_battery"
            android:title="@string/picked_powershare_min_battery_title"
            android:summary="@string/picked_powershare_min_battery_summary"
            settings:min="5"
            android:max="90"
            android:defaultValue="30"
            settings:units="%"
            android:persistent="false" />
    </PreferenceCategory>

    <!-- ===== Screenshots ===== -->
    <PreferenceCategory
        android:key="picked_category_screenshots"
        android:title="@string/picked_category_screenshots">

        <!-- [Miku-Picked UI] FLAG_SECURE off (AOSP Settings.Secure disable_secure_windows) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="disable_secure_windows"
            android:title="@string/picked_disable_secure_windows_title"
            android:summary="@string/picked_disable_secure_windows_summary"
            android:defaultValue="false" />

        <!-- [Miku-Picked UI] Settings.Secure picked_hide_screenshot_detection -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_hide_screenshot_detection"
            android:title="@string/picked_hide_screenshot_detection_title"
            android:summary="@string/picked_hide_screenshot_detection_summary"
            android:defaultValue="false" />

        <Preference
            android:key="picked_screenshot_tester"
            android:title="@string/picked_screenshot_tester_title"
            android:summary="@string/picked_screenshot_tester_summary"
            android:fragment="com.miku.exsettings.fragments.PickedScreenshotTester" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="picked_category_power"
        android:title="@string/picked_category_power">

        <!-- [LineageOS / AxionOS] Advanced restart -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="advanced_reboot"
            android:title="@string/picked_advanced_reboot_title"
            android:summary="@string/picked_advanced_reboot_summary"
            android:defaultValue="false" />

        <!-- [Miku-Picked UI] LTE only while tethering (Settings.Secure picked_tether_lte) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_tether_lte"
            android:title="@string/picked_tether_lte_title"
            android:summary="@string/picked_tether_lte_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Ad blocker (hosts file bind-mounted over /system/etc/hosts) -->
        <Preference
            android:key="picked_adblock"
            android:title="@string/picked_adblock_title"
            android:summary="@string/picked_adblock_summary"
            android:fragment="com.miku.exsettings.fragments.PickedAdblock" />

        <!-- [Miku-Picked UI] Per-app network firewall (system_server PickedFirewall) -->
        <Preference
            android:key="picked_firewall"
            android:title="@string/picked_fw_title"
            android:summary="@string/picked_fw_summary"
            android:fragment="com.miku.exsettings.fragments.PickedFirewall" />

        <!-- [Miku-Picked UI] LTE only while the screen is off (Settings.Secure picked_screen_off_lte,
             SystemUI TetherLteController) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_screen_off_lte"
            android:title="@string/picked_screen_off_lte_title"
            android:summary="@string/picked_screen_off_lte_summary"
            android:defaultValue="true" />

        <!-- [Evolution X] Pocket mode (Settings.System pocket_judge, frameworks PocketService) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="pocket_judge"
            android:title="@string/picked_pocket_mode_title"
            android:summary="@string/picked_pocket_mode_summary"
            android:defaultValue="false" />

        <!-- [Evolution X] Sleep mode -->
        <Preference
            android:key="picked_sleep_mode"
            android:title="@string/picked_sleep_mode_title"
            android:summary="@string/picked_sleep_mode_summary"
            android:fragment="com.miku.exsettings.fragments.PickedSleepMode" />
    </PreferenceCategory>

    <!-- ===== Display ===== -->
    <!-- ===== Games & performance ===== -->
    <PreferenceCategory
        android:key="picked_category_games"
        android:title="@string/picked_category_games">

        <!-- [crDroid / Evolution X / Lunaris] FPS and CPU/GPU info overlay
             (Settings.System picked_perf_overlay, SystemUI PerfOverlayController) -->
        <com.miku.settings.preferences.SystemSettingListPreference
            android:key="picked_perf_overlay"
            android:title="@string/picked_perf_overlay_title"
            android:summary="%s"
            android:entries="@array/picked_perf_overlay_entries"
            android:entryValues="@array/picked_perf_overlay_values"
            android:defaultValue="0" />

        <!-- [Game Space] Opens the Game Space app: the in-game overlay bar and the single
             game list (Settings.System gamespace_game_list, shared with the power profile) -->
        <Preference
            android:key="picked_games"
            android:title="@string/picked_games_title"
            android:summary="@string/picked_games_summary">
            <intent android:targetPackage="io.chaldeaprjkt.gamespace"
                    android:targetClass="io.chaldeaprjkt.gamespace.settings.SettingsActivity" />
        </Preference>
    </PreferenceCategory>

    <!-- ===== GPU ===== -->

    <PreferenceCategory
        android:key="picked_category_gpu"
        android:title="@string/picked_category_gpu">

        <!-- [FlopKernel / Exynos_Valhall_GPUDriver] Mali GPU driver switch: patches the
             kernel's mali.version token (picked_mali_switch); hidden without the selector -->
        <ListPreference
            android:key="picked_gpu_driver"
            android:title="@string/picked_gpu_driver_title"
            android:entries="@array/picked_gpu_driver_entries"
            android:entryValues="@array/picked_gpu_driver_values"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="picked_category_display"
        android:title="@string/picked_category_display">

        <!-- [Lunaris AOSP] Lockscreen app widgets (Settings.Secure
             lockscreen_app_widgets_enabled, SystemUI KeyguardAppWidgetSection) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="lockscreen_app_widgets_enabled"
            android:title="@string/picked_ls_widgets_title"
            android:summary="@string/picked_ls_widgets_summary"
            android:defaultValue="false" />

        <Preference
            android:key="picked_ls_widgets_add"
            android:title="@string/picked_ls_widgets_add_title"
            android:summary="@string/picked_ls_widgets_add_summary"
            android:dependency="lockscreen_app_widgets_enabled"
            android:persistent="false">
            <intent
                android:targetPackage="com.android.systemui"
                android:targetClass="com.android.systemui.lockscreen.KeyguardWidgetConfigActivity" />
        </Preference>

        <!-- [Lunaris AOSP] Edge Aurora: notification glows on the screen edges -->
        <Preference
            android:key="picked_edge_aurora"
            android:title="@string/edge_aurora_title"
            android:summary="@string/edge_aurora_summary"
            android:fragment="com.miku.exsettings.fragments.edgeaurora.EdgeAuroraSettings" />

        <!-- [Miku-Picked UI] Per-app refresh rate (Settings.System picked_app_refresh_rate,
             SystemUI PickedRefreshRateController) -->
        <Preference
            android:key="picked_refresh_rate"
            android:title="@string/picked_refresh_rate_title"
            android:summary="@string/picked_refresh_rate_summary"
            android:fragment="com.miku.exsettings.fragments.PickedRefreshRate" />

        <!-- [uwuAOSP] Cutout force full screen -->
        <Preference
            android:key="picked_cutout_apps"
            android:title="@string/picked_cutout_apps_title"
            android:summary="@string/picked_cutout_apps_summary"
            android:fragment="com.miku.exsettings.fragments.PickedCutoutApps" />
    </PreferenceCategory>

    <!-- ===== Sound ===== -->
    <PreferenceCategory
        android:key="picked_category_sound"
        android:title="@string/picked_category_sound">

        <!-- [Miku-Picked UI] Per-app volume and separate app sound (system_server PickedAppAudio) -->
        <Preference
            android:key="picked_app_audio"
            android:title="@string/picked_app_audio_title"
            android:summary="@string/picked_app_audio_summary"
            android:fragment="com.miku.exsettings.fragments.PickedAppAudio" />

        <!-- [Evolution X] Volume dialog haptics -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="volume_dialog_haptic_feedback"
            android:title="@string/picked_volume_haptics_title"
            android:summary="@string/picked_volume_haptics_summary"
            android:defaultValue="true" />

        <!-- [Miku-Picked UI] Skip tracks with the volume keys (Settings.System.VOLUME_BUTTON_MUSIC_CONTROL) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="volume_button_music_control"
            android:title="@string/picked_volume_music_control_title"
            android:summary="@string/picked_volume_music_control_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <!-- ===== Screenshots ===== -->
    <PreferenceCategory
        android:key="picked_category_screenshot"
        android:title="@string/picked_category_screenshot">

        <!-- [Miku-Picked UI] Clipboard history (Settings.Secure picked_clipboard_history, SystemUI
             ClipboardHistory + Clipboard Quick Settings tile) -->
        <com.miku.settings.preferences.SecureSettingSwitchPreference
            android:key="picked_clipboard_history"
            android:title="@string/picked_clipboard_history_title"
            android:summary="@string/picked_clipboard_history_summary"
            android:defaultValue="true" />

        <!-- [Lunaris AOSP] Screenshot flash -->
        <com.miku.settings.preferences.GlobalSettingSwitchPreference
            android:key="screenshot_flash_enabled"
            android:title="@string/picked_screenshot_flash_title"
            android:summary="@string/picked_screenshot_flash_summary"
            android:defaultValue="true" />

        <!-- [Lunaris AOSP] Hide status bar in screenshots -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="hide_status_bar_in_screenshot"
            android:title="@string/picked_screenshot_hide_statusbar_title"
            android:summary="@string/picked_screenshot_hide_statusbar_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- ===== Play Integrity ===== -->
    <PreferenceCategory
        android:key="picked_category_integrity"
        android:title="@string/picked_category_integrity">

        <!-- [Evolution X / AxionOS] Pixel fingerprint for DroidGuard and Play Store
             (Settings.System spoof_pif_enabled, PickedSpoofManager in system_server) -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="spoof_pif_enabled"
            android:title="@string/picked_pif_title"
            android:summary="@string/picked_pif_summary"
            android:defaultValue="true" />

        <Preference
            android:key="picked_pif_fingerprint"
            android:title="@string/picked_pif_fingerprint_title"
            android:dependency="spoof_pif_enabled" />

        <!-- [Evolution X / AxionOS] TrickyStore keystore attestation spoof -->
        <com.miku.settings.preferences.SystemSettingSwitchPreference
            android:key="spoof_trickystore_enabled"
            android:title="@string/picked_trickystore_title"
            android:summary="@string/picked_trickystore_summary"
            android:defaultValue="true" />

        <Preference
            android:key="picked_trickystore_keybox"
            android:title="@string/picked_trickystore_keybox_title"
            android:dependency="spoof_trickystore_enabled" />

        <Preference
            android:key="picked_bootloader_spoof"
            android:title="@string/picked_bootloader_spoof_title"
            android:summary="@string/picked_bootloader_spoof_summary"
            android:selectable="false" />
    </PreferenceCategory>

    <!-- ===== Connected devices ===== -->
    <PreferenceCategory
        android:key="picked_category_devices"
        android:title="@string/picked_category_devices">

        <!-- [GoogleSpoofForWear by 73sydney] Google as brand/manufacturer for watch apps
             (persist.sys.picked.google_spoof_wear, read by android.os.Build at boot) -->
        <SwitchPreferenceCompat
            android:key="picked_google_spoof_wear"
            android:title="@string/picked_google_spoof_wear_title"
            android:summary="@string/picked_google_spoof_wear_summary"
            android:persistent="false" />

        <!-- [Miku-Picked UI] Desktop mode on external displays (Android 16 connected displays:
             persist.wm.debug.desktop_experience_devopts + force desktop on external displays) -->
        <SwitchPreferenceCompat
            android:key="picked_external_desktop"
            android:title="@string/picked_external_desktop_title"
            android:summary="@string/picked_external_desktop_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
