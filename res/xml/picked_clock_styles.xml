<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:key="picked_clock_styles"
    android:title="@string/picked_clock_styles_title">

    <com.android.settingslib.widget.LayoutPreference
        android:key="picked_clock_preview"
        android:layout="@layout/picked_clock_preview"
        android:selectable="false" />

    <com.miku.settings.preferences.SecureSettingListPreference
        android:key="lock_screen_custom_clock_color_mode"
        android:title="@string/picked_clock_color_mode_title"
        android:entries="@array/picked_clock_color_mode_entries"
        android:entryValues="@array/picked_clock_color_mode_values"
        android:summary="%s"
        android:defaultValue="default" />

    <com.miku.settings.colorpicker.SecureSettingColorPickerPreference
        android:key="lock_screen_custom_clock_custom_color"
        android:title="@string/picked_clock_custom_color_title"
        android:defaultValue="0xffffffff"
        settings:defaultColorValue="0xffffffff" />

    <com.miku.exsettings.preferences.CustomSecureSeekBarPreference
        android:key="lock_screen_custom_clock_size_scale"
        android:title="@string/picked_clock_size_title"
        android:defaultValue="100"
        android:max="150"
        settings:min="50"
        settings:units="%" />

    <com.miku.exsettings.preferences.CustomSecureSeekBarPreference
        android:key="lock_screen_custom_clock_opacity"
        android:title="@string/picked_clock_opacity_title"
        android:defaultValue="100"
        android:max="100"
        settings:min="0"
        settings:units="%" />

    <com.miku.exsettings.preferences.CustomSecureSeekBarPreference
        android:key="lock_screen_custom_clock_margin_top"
        android:title="@string/picked_clock_margin_top_title"
        android:defaultValue="15"
        android:max="100"
        settings:min="0"
        settings:units="px" />

    <com.miku.settings.preferences.SecureSettingSwitchPreference
        android:key="lock_screen_custom_clock_aod_anim"
        android:title="@string/picked_clock_aod_anim_title"
        android:summary="@string/picked_clock_aod_anim_summary"
        android:defaultValue="true" />

    <com.android.settingslib.widget.FooterPreference
        android:key="picked_clock_footer"
        android:title="@string/picked_clock_footer"
        android:selectable="false"
        settings:searchable="false" />
</PreferenceScreen>
