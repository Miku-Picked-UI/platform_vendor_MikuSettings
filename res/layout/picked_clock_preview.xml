     Custom lockscreen clock picker, after the Evolution X / risingOS clock preview.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="210dp"
        android:layout_height="400dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/picked_clock_preview_bg"
        android:clipToOutline="true"
        android:padding="6dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/picked_clock_pager"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_gravity="top"
            android:paddingHorizontal="10dp"
            android:paddingVertical="30dp" />

        <TextView
            android:id="@+id/picked_clock_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/picked_clock_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/picked_clock_swipe_hint"
        android:textAlignment="center"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/picked_clock_apply"
        style="@android:style/Widget.DeviceDefault.Button.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/apply" />
</LinearLayout>
